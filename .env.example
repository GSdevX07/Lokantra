# ============================================================================
# Lokantra Swarm Prediction Engine Configuration
# ============================================================================

# LLM API Configuration (OpenAI Compatible)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

# Zep Cloud Knowledge Graph Memory Configuration
ZEP_API_KEY=your_zep_api_key_here

# Flask Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
DEBUG=True

# ============================================================================
# Cognitive Swarm Router Configuration (Laya System 1 + Akida Reflex Gate)
# ============================================================================
# Mode: 'hybrid' (Hierarchical Tier 0 Gate + Laya System 1 + System 2 LLM)
#       'baseline' (Phase 1 Baseline for A/B testing & benchmarking)
SWARM_ROUTER_MODE=hybrid

# Tier 0 Reflex Gate Backend: 'heuristic' (Phase 3 Core, <1ms)
#                             'akida' (Phase 4 Research Neuromorphic LIF Plugin)
REFLEX_GATE_BACKEND=heuristic

# Synaptic arousal threshold to engage (0.0 to 1.0, default 0.35)
AROUSAL_THRESHOLD=0.35

# Laya System 1 Engine (Open-Source Apache 2.0 ModernBERT-based Decision Router)
# Model: 'convaiinnovations/laya' or fine-tuned checkpoint
# Device: 'cpu' or 'cuda'
LAYA_MODEL=convaiinnovations/laya
LAYA_DEVICE=cpu

# ============================================================================
# Supabase Authentication & User Tracking (Google OAuth)
# ============================================================================
# Find these in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================================
# Voice Input Configuration
# ============================================================================
SARVAM_API_KEY=your_voice_api_key_here
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text
SARVAM_MODEL=saaras:v4


# ============================================================================
# viaSocket MCP & Action Execution Governance Configuration
# ============================================================================
# viaSocket MCP Endpoint URL (from your viaSocket dashboard or unique flow URL)
VIASOCKET_MCP_ENDPOINT=https://flow.viasocket.com/mcp/your-endpoint-id
VIASOCKET_API_KEY=your_viasocket_api_key_optional
# Mode: 'auto' (connects if URL configured, otherwise falls back to demo mode)
#       'live' (strict real connection)
#       'demo' (offline-safe high-fidelity interactive sandbox for hackathon demos)
VIASOCKET_MODE=auto
VIASOCKET_TIMEOUT=5.0
VIASOCKET_CACHE_TTL=300
VIASOCKET_HITL_AUTO_APPROVE_READ=true
VIASOCKET_MAX_CALLS_PER_ROUND=3

# viaSocket Embed Credentials (from viaSocket dashboard embed/settings)
VIASOCKET_ORG_ID=your_viasocket_org_id_here
VIASOCKET_PROJECT_ID=your_viasocket_project_id_here
VIASOCKET_EMBED_SECRET=your_viasocket_embed_secret_here
