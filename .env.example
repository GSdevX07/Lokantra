# LLM API Configuration (supports any LLM API compatible with the OpenAI SDK)
# Recommended: Alibaba Bailian Qwen-plus via the Bailian Platform
# https://bailian.console.aliyun.com/
# High consumption: try simulations with fewer than 40 rounds first
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# Zep Cloud Configuration
# Free monthly quota is sufficient for basic usage: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key

# ============================================================================
# Cognitive Swarm Router Configuration (Laya System 1 + Akida SNN Gating)
# ============================================================================
# Mode: 'hybrid' (Hierarchical Tier 0 Gate + Laya System 1 + System 2 LLM)
#       'baseline' (Phase 1 Baseline for A/B testing & benchmarking)
SWARM_ROUTER_MODE=hybrid

# Tier 0 Reflex Gate Backend: 'heuristic' (Phase 3 Core, <1ms)
#                             'akida' (Phase 4 Research Neuromorphic LIF Plugin)
REFLEX_GATE_BACKEND=heuristic

# Synaptic arousal threshold to engage (0.0 to 1.0, default 0.35)
AROUSAL_THRESHOLD=0.35

# Laya System 1 Engine (Open-Source Apache 2.0 ModernBERT-based Decision Router)
# Model: 'convaiinnovations/laya' or fine-tuned checkpoint
# Device: 'cpu' or 'cuda'
LAYA_MODEL=convaiinnovations/laya
LAYA_DEVICE=cpu
